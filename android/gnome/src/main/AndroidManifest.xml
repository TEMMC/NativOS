<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Special access: Android still requires the user to approve these in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:allowBackup="true"
        android:label="MT-GNOME"
        android:icon="@drawable/ic_mt_gnome"
        android:roundIcon="@drawable/ic_mt_gnome"
        android:theme="@style/Theme.MTGnome"
        android:supportsRtl="true"
        android:resizeableActivity="true">
        <receiver
            android:name=".MTGNOMEDeviceAdminReceiver"
            android:label="MT-GNOME device lock"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/mt_gnome_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <service android:name=".DesktopDockService" android:exported="false" />
        <service android:name=".PointerOverlayService" android:exported="false" />
        <service
            android:name=".MTGNOMEAccessibilityService"
            android:label="MT-GNOME Pointer"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/mt_gnome_accessibility" />
        </service>
        <activity android:name=".FileManagerActivity" android:exported="false" android:label="MT Files" android:screenOrientation="landscape" android:resizeableActivity="true" />
        <activity android:name=".DesktopToolsActivity" android:exported="false" android:label="Desktop Tools" android:screenOrientation="landscape" android:resizeableActivity="true" />
        <activity android:name=".LockSecurityActivity" android:exported="false" android:label="Desktop security" android:screenOrientation="landscape" android:excludeFromRecents="true" />
        <activity android:name=".DistroCatalogActivity" android:exported="false" android:label="GNOME Terminal catalogue" android:screenOrientation="landscape" android:resizeableActivity="true" />
        <activity
            android:name=".GnomeHomeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
