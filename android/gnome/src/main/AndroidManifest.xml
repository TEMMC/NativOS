<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:label="MT-GNOME"
        android:icon="@drawable/ic_mt_gnome"
        android:roundIcon="@drawable/ic_mt_gnome"
        android:theme="@style/Theme.MTGnome"
        android:supportsRtl="true"
        android:resizeableActivity="true">
        <service android:name=".DesktopDockService" android:exported="false" />
        <service android:name=".PointerOverlayService" android:exported="false" />
        <service
            android:name=".MTGNOMEAccessibilityService"
            android:label="MT-GNOME Pointer"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/mt_gnome_accessibility" />
        </service>
        <activity android:name=".FileManagerActivity" android:exported="false" android:label="MT Files" android:resizeableActivity="true" />
        <activity android:name=".DesktopToolsActivity" android:exported="false" android:label="Desktop Tools" android:resizeableActivity="true" />
        <activity android:name=".DistroCatalogActivity" android:exported="false" android:label="GNOME Terminal catalogue" android:resizeableActivity="true" />
        <activity
            android:name=".GnomeHomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
